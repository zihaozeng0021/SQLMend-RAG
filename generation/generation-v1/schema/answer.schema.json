{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlmend-rag.local/schema/generation-v1-answer.schema.json",
  "title": "SQLMend Generation v1 Answer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis",
    "root_cause",
    "corrected_sql",
    "explanation",
    "dialect_compatibility",
    "version_compatibility",
    "confidence",
    "insufficient_evidence",
    "citations"
  ],
  "properties": {
    "diagnosis": {"type": "string", "minLength": 1},
    "root_cause": {"type": "string", "minLength": 1},
    "corrected_sql": {"type": ["string", "null"]},
    "explanation": {"type": "string", "minLength": 1},
    "dialect_compatibility": {"$ref": "#/$defs/compatibility"},
    "version_compatibility": {"$ref": "#/$defs/compatibility"},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "insufficient_evidence": {"type": "boolean"},
    "citations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "explanation"],
      "properties": {
        "status": {"type": "string", "enum": ["compatible", "incompatible", "unknown"]},
        "explanation": {"type": "string", "minLength": 1}
      }
    }
  }
}
