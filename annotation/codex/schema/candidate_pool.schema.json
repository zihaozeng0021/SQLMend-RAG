{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlmendrag.local/schema/candidate_pool.schema.json",
  "title": "SQLMendRAG judged candidate pool",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_id", "query_text_hash", "pool_config", "candidates"],
  "properties": {
    "query_id": {"type": "string", "pattern": "^DEV[0-9]{4}$"},
    "query_text_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pool_config": {
      "type": "object",
      "required": ["bm25_top_k", "dense_top_k", "dense_method"],
      "properties": {
        "bm25_top_k": {"type": "integer", "minimum": 1},
        "dense_top_k": {"type": "integer", "minimum": 1},
        "dense_method": {"type": "string", "minLength": 1}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id", "retrieved_by", "ranks", "scores", "relevance",
          "judgment_origin", "judgment_method"
        ],
        "properties": {
          "chunk_id": {"type": "string"},
          "retrieved_by": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["bm25", "dense", "source_link"]}
          },
          "ranks": {"type": "object"},
          "scores": {"type": "object"},
          "relevance": {"enum": [0, 1, 2]},
          "judgment_origin": {"const": "codex_machine_proposed"},
          "judgment_method": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
